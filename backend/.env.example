# Backend Environment Variables (Server-only secrets)

# Server Configuration
PORT=8787
NODE_ENV=development

# MongoDB Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DB_NAME=raja_studio

# JWT Authentication
JWT_SECRET=your-very-secure-random-secret-key-here

# Cloudflare R2 Storage (Supports both CLOUDFLARE_R2_* and R2_* naming)
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-r2-api-access-key-id
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-r2-api-secret-access-key
CLOUDFLARE_R2_BUCKET_NAME=your-bucket-name
CLOUDFLARE_R2_REGION=auto
CLOUDFLARE_R2_PUBLIC_URL=https://pub-your-id.r2.dev

# Upload Limits
MAX_UPLOAD_BYTES=26214400

# CORS Configuration (Frontend URLs - comma separated)
# Production domain: https://raja-studio-gmys.vercel.app
# Old domain kept temporarily: https://rajastudio-rosy.vercel.app
CLIENT_ORIGIN=http://localhost:5173,https://raja-studio-gmys.vercel.app,https://rajastudio-rosy.vercel.app

# Backend Environment Variables (Server-only secrets)

# Server Configuration
PORT=8787
NODE_ENV=development

# MongoDB Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/
MONGODB_DB_NAME=raja_studio

# JWT Authentication
JWT_SECRET=your-very-secure-random-secret-key-here

# Cloudflare R2 Storage
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-key
CLOUDFLARE_R2_BUCKET_NAME=raja-studio-images
CLOUDFLARE_R2_REGION=auto

# Upload Limits
MAX_UPLOAD_BYTES=26214400

# CORS Configuration (Frontend URLs - comma separated)
# Vercel URL added for production
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,https://rajastudio-rosy.vercel.app
